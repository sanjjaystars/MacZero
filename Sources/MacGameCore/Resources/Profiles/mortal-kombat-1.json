{
  "id": "mortal-kombat-1",
  "gameTitle": "Mortal Kombat 1",
  "graphicsApi": "DirectX 12",
  "runtimeRecommendation": "Wine 9.0+ / GPTK 2",
  "vkd3dConfig": [
    "dxr11",
    "shader_cache",
    "single_queue"
  ],
  "dxvkConfig": {},
  "environment": {
    "VKD3D_CONFIG": "dxr11,shader_cache,single_queue",
