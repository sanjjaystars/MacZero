  "launchArguments": [
    "-dx12",
    "-novid"
  ],
  "dependencies": [
    "vcrun2022",
    "d3dcompiler_47"
  ],
  "knownIssues": [
    "Online multiplayer requiring kernel-level Denuvo / Anti-Cheat may fail online matchmaking; Story, Towers, Local Versus, and Invasions work reliably with VKD3D-Proton.",
